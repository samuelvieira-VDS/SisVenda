<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sisvenda.Views.ClienteDetailPage"
             Title="Detalhes do Cliente">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Label Text="CPF/CNPJ" FontAttributes="Bold" FontSize="14"/>
            <Entry x:Name="CpfCnpjEntry" Placeholder="Digite o CPF ou CNPJ"/>

            <Label Text="Nome" FontAttributes="Bold" FontSize="14" Margin="0,10,0,0"/>
            <Entry x:Name="NomeEntry" Placeholder="Digite o nome do cliente"/>

            <Label Text="Endereço" FontAttributes="Bold" FontSize="14" Margin="0,10,0,0"/>
            <Entry x:Name="EnderecoEntry" Placeholder="Digite o endereço"/>

            <Label Text="Número" FontAttributes="Bold" FontSize="14" Margin="0,10,0,0"/>
            <Entry x:Name="NumeroEntry" Placeholder="Digite o número"/>

            <Label Text="Complemento" FontAttributes="Bold" FontSize="14" Margin="0,10,0,0"/>
            <Entry x:Name="ComplementoEntry" Placeholder="Digite o complemento (opcional)"/>

            <Label Text="Telefone" FontAttributes="Bold" FontSize="14" Margin="0,10,0,0"/>
            <Entry x:Name="TelefoneEntry" Placeholder="Digite o telefone"/>

            <Label Text="Bairro" FontAttributes="Bold" FontSize="14" Margin="0,10,0,0"/>
            <Entry x:Name="BairroEntry" Placeholder="Digite o bairro"/>

            <Label Text="Cidade" FontAttributes="Bold" FontSize="14" Margin="0,10,0,0"/>
            <Entry x:Name="CidadeEntry" Placeholder="Digite a cidade"/>

            <Label Text="CEP" FontAttributes="Bold" FontSize="14" Margin="0,10,0,0"/>
            <Entry x:Name="CepEntry" Placeholder="Digite o CEP"/>

            <Button Text="Salvar" 
                   Clicked="OnSaveClienteClicked"
                   CornerRadius="5"
                   BackgroundColor="#007AFF"
                   TextColor="White"
                   Margin="0,20,0,0"
                   FontSize="16"
                   Padding="10"/>

            <Button Text="Cancelar" 
                   Clicked="OnCancelClicked"
                   CornerRadius="5"
                   BackgroundColor="#FF3B30"
                   TextColor="White"
                   FontSize="16"
                   Padding="10"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
