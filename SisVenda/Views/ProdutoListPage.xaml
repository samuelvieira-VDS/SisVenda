<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Sisvenda.Converters"
             x:Class="Sisvenda.Views.ProdutoListPage"
             Title="Produtos">

    <Grid RowDefinitions="auto,*,auto" Padding="0">
        <!-- Barra de Ferramentas -->
        <Grid ColumnDefinitions="*,auto" Padding="10" BackgroundColor="#F0F0F0">
            <SearchBar x:Name="SearchBar" 
                      Placeholder="Buscar produtos..." 
                      PlaceholderColor="Gray"
                      TextChanged="OnSearchTextChanged"/>
            <Button Grid.Column="1" 
                   Text="+" 
                   FontSize="24"
                   Clicked="OnAddProdutoClicked"
                   CornerRadius="5"
                   WidthRequest="50"
                   HeightRequest="50"
                   BackgroundColor="#007AFF"
                   TextColor="White"
                   Padding="0"/>
        </Grid>

        <!-- Lista de Produtos -->
        <CollectionView Grid.Row="1" 
                       x:Name="ProdutoCollectionView"
                       ItemsSource="{Binding Produtos}"
                       SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Padding="10" Margin="10" Spacing="0">
                        <Frame Padding="10" CornerRadius="10" BorderColor="#E0E0E0" HasShadow="False" BackgroundColor="White">
                            <Grid ColumnDefinitions="*,auto" RowDefinitions="auto,auto,auto,auto" Padding="10">
                            <!-- Código e Nome -->
                            <Label Grid.Column="0" 
                                  Grid.Row="0"
                                  Text="{Binding Nome, StringFormat='Nome: {0}'}" 
                                  FontSize="16" 
                                  FontAttributes="Bold"/>
                            <Label Grid.Column="0"
                                  Grid.Row="1"
                                  Text="{Binding Codigo, StringFormat='Código: {0}'}" 
                                  FontSize="12" 
                                  TextColor="Gray"/>

                            <!-- Descrição -->
                            <Label Grid.Column="0"
                                  Grid.Row="2"
                                  Text="{Binding Descricao}" 
                                  FontSize="12" 
                                  TextColor="DarkGray"
                                  LineBreakMode="TailTruncation"/>

                            <!-- Preços -->
                            <StackLayout Grid.Column="0"
                                        Grid.Row="3"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                <Label Text="{Binding Preco, StringFormat='Venda: R$ {0:F2}'}" 
                                      FontSize="12" 
                                      FontAttributes="Bold"
                                      TextColor="#007AFF"/>
                                <Label Text="{Binding PrecoCusto, StringFormat='Custo: R$ {0:F2}'}" 
                                      FontSize="12" 
                                      TextColor="Orange"/>
                            </StackLayout>

                            <!-- Botões de Ação -->
                            <StackLayout Grid.Column="1"
                                        Grid.Row="0"
                                        Grid.RowSpan="4"
                                        Orientation="Vertical"
                                        Spacing="5"
                                        VerticalOptions="Center">
                                <Button x:Name="EditButton"
                                       Text="✎"
                                       FontSize="18"
                                       Clicked="OnEditProdutoClicked"
                                       CornerRadius="20"
                                       WidthRequest="40"
                                       HeightRequest="40"
                                       BackgroundColor="#34C759"
                                       TextColor="White"
                                       CommandParameter="{Binding .}"/>
                                <Button x:Name="DeleteButton"
                                       Text="✕"
                                       FontSize="18"
                                       Clicked="OnDeleteProdutoClicked"
                                       CornerRadius="20"
                                       WidthRequest="40"
                                       HeightRequest="40"
                                       BackgroundColor="#FF3B30"
                                       TextColor="White"
                                       CommandParameter="{Binding .}"/>
                            </StackLayout>
                        </Grid>
                        </Frame>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Indicador de Carregamento -->
        <ActivityIndicator Grid.Row="1"
                          IsRunning="{Binding IsLoading}"
                          IsVisible="{Binding IsLoading}"
                          Color="#007AFF"/>

        <!-- Mensagem Vazia -->
        <StackLayout Grid.Row="1"
                    IsVisible="{Binding Produtos.Count, Converter={StaticResource IsListEmptyConverter}}"
                    Padding="20"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
            <Label Text="Nenhum produto encontrado"
                  FontSize="16"
                  HorizontalOptions="Center"
                  TextColor="Gray"/>
            <Label Text="Toque em + para adicionar um novo produto"
                  FontSize="12"
                  HorizontalOptions="Center"
                  TextColor="LightGray"/>
        </StackLayout>
    </Grid>
</ContentPage>
